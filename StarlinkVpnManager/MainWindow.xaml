<Window x:Class="StarlinkVpnManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیر VPN استارلینک"
        Height="700"
        Width="1000"
        MinHeight="560"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="مدیر VPN استارلینک" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="پروفایل‌های WireGuard را امن مدیریت کنید"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#17352F"
                    CornerRadius="12"
                    Padding="12,7">
                <TextBlock Text="WIREGUARD  ·  WINDOWS"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           FlowDirection="LeftToRight" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,18">
            <DockPanel>
                <TextBlock Text="●"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="16"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Text="در حال آماده‌سازی برنامه..."
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button x:Name="ImportButton"
                        Content="＋  افزودن پروفایل"
                        Click="ImportButton_Click"
                        DockPanel.Dock="Right"
                        Margin="0" />
                <TextBlock Text="پروفایل‌های شما"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <ListBox x:Name="ProfilesList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="#172437" />
                                <Setter Property="BorderBrush" Value="#24344A" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#48D6C3" />
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1B3040" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B536D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ServiceName}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StatusDetails}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="هنوز پروفایلی اضافه نشده"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="برای شروع، فایل پیکربندی .conf را وارد کنید."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button x:Name="ConnectButton"
                        Content="اتصال"
                        Click="ConnectButton_Click" />
                <Button x:Name="DiagnosticsButton"
                        Content="آزمایش هوشمند"
                        Background="#20384A"
                        Foreground="{StaticResource AccentBrush}"
                        Click="DiagnosticsButton_Click" />
                <Button x:Name="DisconnectButton"
                        Content="قطع اتصال"
                        Background="#26364B"
                        Foreground="{StaticResource TextBrush}"
                        Click="DisconnectButton_Click" />
                <Button x:Name="DeleteButton"
                        Content="حذف پروفایل"
                        Background="#4A2630"
                        Foreground="#FFD6DC"
                        Margin="0"
                        Click="DeleteButton_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="DiagnosticsPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="DiagnosticsSummaryText"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ActiveRouteText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="این بررسی پنج ping به 1.1.1.1 و 8.8.8.8 می‌فرستد؛ برای پروفایل انتخاب‌شده نام Endpoint نیز با DNS سیستم بررسی می‌شود."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticsDetailsText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="RecommendationsList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="فایل‌های پیکربندی با رمزگذاری ویندوز برای حساب کاربری فعلی نگهداری می‌شوند."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   Margin="0,22,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
