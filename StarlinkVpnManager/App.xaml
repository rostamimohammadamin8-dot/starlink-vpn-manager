<Application x:Class="StarlinkVpnManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBackground" Color="#121D2E" />
        <SolidColorBrush x:Key="PanelBorder" Color="#24344A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#48D6C3" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4B8" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#07131D" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Resources>
</Application>
