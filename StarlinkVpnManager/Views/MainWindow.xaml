<Window x:Class="StarlinkVpnManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیر VPN استارلینک"
        Height="900"
        Width="1000"
        MinHeight="720"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="مدیر VPN استارلینک" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="پروفایل‌های WireGuard و تونل‌های sing-box را امن مدیریت کنید"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#17352F"
                    CornerRadius="12"
                    Padding="12,7">
                <TextBlock Text="WIREGUARD  ·  SING-BOX"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="Bold"
                           FlowDirection="LeftToRight" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,18">
            <DockPanel>
                <TextBlock Text="●"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="16"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#402630" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#17352F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionStateText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   FlowDirection="LeftToRight" />
                    </Border>
                    <Border Background="#17352F" CornerRadius="10" Padding="10,6" Margin="12,0,0,0">
                        <TextBlock Text="{Binding CurrentLatencyText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FlowDirection="LeftToRight" />
                    </Border>
                    <Button Content="اندازه‌گیری تأخیر"
                            Command="{Binding RefreshLatencyCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="Salmon" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="پروفایل‌های شما"
                           FontSize="17"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="ImportButton"
                        Content="＋  افزودن پروفایل"
                        Click="ImportButton_Click"
                        DockPanel.Dock="Left"
                        Margin="0" />
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <ListBox x:Name="ProfilesList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="#172437" />
                                <Setter Property="BorderBrush" Value="#24344A" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#48D6C3" />
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1B3040" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B536D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ServiceName}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StatusDetails}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="هنوز پروفایلی اضافه نشده"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="برای شروع، فایل پیکربندی .conf را وارد کنید."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button x:Name="ConnectButton"
                        Content="{Binding ConnectionButtonText}"
                        Command="{Binding ToggleConnectionCommand}" />
                <Button x:Name="SelectSingBoxConfigButton"
                        Content="پیکربندی sing-box"
                        Background="#20384A"
                        Foreground="{StaticResource AccentBrush}"
                        Click="SelectSingBoxConfigButton_Click" />
                <Button x:Name="DiagnosticsButton"
                        Content="آزمایش هوشمند"
                        Background="#20384A"
                        Foreground="{StaticResource AccentBrush}"
                        Click="DiagnosticsButton_Click" />
                <Button x:Name="DeleteButton"
                        Content="حذف پروفایل"
                        Background="#4A2630"
                        Foreground="#FFD6DC"
                        Margin="0"
                        Click="DeleteButton_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="DiagnosticsPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="DiagnosticsSummaryText"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ActiveRouteText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="این بررسی ping، زمان TCP/HTTP و پایداری مسیر را می‌سنجد؛ برای پروفایل انتخاب‌شده نام Endpoint نیز با DNS سیستم بررسی می‌شود. هیچ تنظیم شبکه‌ای خودکار تغییر نمی‌کند."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticsDetailsText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <ItemsControl x:Name="RecommendationsList" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <CheckBox Content="دورزدن مسیر ترافیک سرویس‌های هوش مصنوعی"
                              IsChecked="{Binding EnableAiBypass, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}"
                              FontWeight="SemiBold" />
                    <TextBlock Text="برای اتصال بعدی sing-box اعمال می‌شود و به outbound با tag برابر direct نیاز دارد."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <CheckBox Content="محافظت سراسری Kill Switch (نیازمند مدیر)"
                              IsChecked="{Binding IsKillSwitchEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding CanToggleKillSwitch}"
                              Click="KillSwitchToggle_Click"
                              Foreground="#FFD6DC"
                              Margin="0,9,0,0" />
                    <TextBlock Text="در حالت فعال، خروجی همهٔ برنامه‌ها به‌جز IP سرور VPN مسدود می‌شود."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SingBoxConfigPath}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               FlowDirection="LeftToRight" />
                    <Expander Header="پیش‌نمایش قواعد sing-box"
                              Foreground="{StaticResource MutedBrush}"
                              Margin="0,8,0,0">
                        <TextBox Text="{Binding AiRoutingRulesJson}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Height="115"
                                 Background="#0B1220"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 FontFamily="Consolas"
                                 FlowDirection="LeftToRight" />
                    </Expander>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding LatencySummary}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="گزارش زندهٔ اتصال"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5" />
                    <ListBox x:Name="ConnectionLogList"
                             ItemsSource="{Binding ConnectionLogs}"
                             Height="135"
                             Background="#0B1220"
                             Foreground="{StaticResource MutedBrush}"
                             BorderBrush="{StaticResource PanelBorder}"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="فایل‌های پیکربندی با رمزگذاری ویندوز برای حساب کاربری فعلی نگهداری می‌شوند."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   Margin="0,22,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
